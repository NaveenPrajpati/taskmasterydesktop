{
  "name": "taskmastery-desktop",
  "productName": "Tazor",
  "version": "0.1.0",
  "description": "Tazor for Windows",
  "author": "Tazor",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && node scripts/start-electron.js",
    "dev": "npm run build && node scripts/start-electron.js --url=http://localhost:3000",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:store": "npm run build && electron-builder --win appx",
    "dist:mac": "npm run build && electron-builder --mac",
    "release": "npm run build && electron-builder --win nsis --publish always",
    "store-assets": "node scripts/make-store-assets.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
